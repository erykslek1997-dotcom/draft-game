{
  "name": "draft-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "tsx scripts/testDraftRules.ts && tsx scripts/testRotationEditable.ts && tsx scripts/testRoleFitShadow.ts && tsx scripts/testPlayoffBpm2.ts && tsx scripts/testRoleScalability.ts && tsx scripts/testScoringLogic.ts",
    "audit:data": "tsx scripts/auditDataProvenance.ts",
    "audit:historical": "tsx scripts/auditHistoricalTalent.ts",
    "audit:scoring": "tsx scripts/auditScoringLogic.ts",
    "validate:bpm2": "tsx scripts/validateBpm2Total.ts",
    "extract:playoff-bpm2": "tsx scripts/extractPlayoffBpm2.ts",
    "report:playoff-bpm2": "tsx scripts/reportPlayoffBpmCalibration.ts",
    "build:runtime-percentiles": "tsx scripts/buildRuntimePercentiles.ts",
    "build:runtime-provenance": "tsx scripts/buildRuntimeProvenance.ts",
    "build:runtime-lookups": "tsx scripts/buildRuntimeSpanLookups.ts",
    "build:runtime-data": "npm run build:runtime-lookups && npm run build:runtime-percentiles && npm run build:runtime-provenance",
    "build:ai-test-pool": "tsx scripts/buildAiTestPool.ts",
    "analyze:ai-average-pick": "tsx scripts/analyzeAiAveragePick.ts",
    "report:role-shadow": "tsx scripts/reportRoleFitShadow.ts",
    "test:role-shadow": "tsx scripts/testRoleFitShadow.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
